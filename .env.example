PORT=3000
# Optional at build time: final origin for canonical links and sitemap
SITE_URL=
# Required to accept inquiries on Google Cloud; create Firestore and grant the service identity write access.
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Optional for local testing with a running Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
